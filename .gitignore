# Datos locales (no subir a GitHub — contienen información de pacientes y caja)
data.json
data_*.json
*.json

# Excepción: el manifest no tiene datos de nadie. Es el archivito que le dice
# al navegador cómo se llama la app y qué ícono ponerle. Sin él no se puede
# instalar como app. Cualquier OTRO .json sigue quedando fuera.
!manifest.json

# Copias de seguridad que se hacen antes de tocar el archivo grande
index.html.backup-*

# Claude session files
.claude/

# macOS
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.pyc
*.pyo

# Logs
*.log
